---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const teams = (await getCollection('teams')).sort((a, b) => a.data.category.localeCompare(b.data.category));
const games = (await getCollection('games')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const selectedTeamId = Astro.url.searchParams.get('team') === 'h2' || teams.some((team) => team.id === Astro.url.searchParams.get('team'))
  ? Astro.url.searchParams.get('team')
  : teams[0]?.id;

const rows = await Promise.all(
  games.map(async (game) => {
    const team = await getEntry('teams', game.data.team);
    const teamName = team?.data.name ?? game.data.team;
    const isHome = game.data.homeOrAway === 'thuis';
    return {
      ...game.data,
      thuisploeg: isHome ? teamName : game.data.opponent,
      bezoekers: isHome ? game.data.opponent : teamName,
    };
  })
);

const maandAfkortingen = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
const dagAfkortingen = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
const formatDatum = (date: Date) =>
  `${String(date.getDate()).padStart(2, '0')} ${maandAfkortingen[date.getMonth()]} ${String(date.getFullYear() % 100).padStart(2, '0')}`;
---

<BaseLayout title="Kalender">
  <h1 class="text-3xl font-bold text-slate-900">Wedstrijdkalender</h1>

  <div class="mt-6 flex flex-wrap gap-2 border-b border-slate-200">
    {teams.map((team) => (
      <button
        type="button"
        data-tab-target={team.id}
        class:list={[
          'tab-button cursor-pointer border-b-2 px-4 py-2 text-sm font-medium transition-colors',
          team.id === selectedTeamId ? 'border-orange-600 text-orange-600' : 'border-transparent text-slate-600 hover:text-orange-600',
        ]}
      >
        {team.data.name}
      </button>
    ))}
    <button
      type="button"
      data-tab-target="h2"
      class:list={[
        'tab-button cursor-pointer border-b-2 px-4 py-2 text-sm font-medium transition-colors',
        selectedTeamId === 'h2' ? 'border-orange-600 text-orange-600' : 'border-transparent text-slate-600 hover:text-orange-600',
      ]}
    >
      H2 competitie
    </button>
  </div>

  {teams.map((team) => (
    <div data-tab-panel={team.id} class:list={['mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm', { hidden: team.id !== selectedTeamId }]}>
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-100 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-3">Dag</th>
            <th class="px-4 py-3">Datum</th>
            <th class="px-4 py-3">Uur</th>
            <th class="px-4 py-3">Thuisploeg</th>
            <th class="px-4 py-3">Bezoekers</th>
            <th class="px-4 py-3">Locatie</th>
          </tr>
        </thead>
        <tbody>
          {rows
            .filter((row) => row.team === team.id)
            .map((row) => (
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3">{dagAfkortingen[row.date.getDay()]}</td>
                <td class="whitespace-nowrap px-4 py-3">{formatDatum(row.date)}</td>
                <td class="px-4 py-3">{row.time}h</td>
                <td class="px-4 py-3 font-medium text-slate-900">{row.thuisploeg}</td>
                <td class="px-4 py-3">{row.bezoekers}</td>
                <td class="px-4 py-3">{row.location}</td>
              </tr>
            ))}
        </tbody>
      </table>
    </div>
  ))}
  <div data-tab-panel="h2" class:list={['mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm', { hidden: selectedTeamId !== 'h2' }]}>
    <p id="h2-status" role="status" class="px-4 py-3 text-sm text-slate-600">Kalender laden...</p>
    <table id="h2-table" class="hidden w-full text-left text-sm">
      <thead class="bg-slate-100 text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Datum</th>
          <th class="px-4 py-3">Uur</th>
          <th class="px-4 py-3">Thuisploeg</th>
          <th class="px-4 py-3">Bezoekers</th>
          <th class="px-4 py-3">Uitslag</th>
        </tr>
      </thead>
      <tbody id="h2-rows"></tbody>
    </table>
  </div>
</BaseLayout>

<script>
  type CalendarGame = {
    DateTime: string;
    TeamHome: string;
    TeamAway: string;
    ScoreHome: number | null;
    ScoreAway: number | null;
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
  const status = document.querySelector<HTMLElement>('#h2-status')!;
  const table = document.querySelector<HTMLTableElement>('#h2-table')!;
  const body = document.querySelector<HTMLTableSectionElement>('#h2-rows')!;
  let h2Loaded = false;
  let h2Loading = false;

  const loadH2 = async () => {
    if (h2Loaded || h2Loading) return;
    h2Loading = true;
    status.textContent = 'Kalender laden...';
    status.classList.remove('hidden');

    try {
      const response = await fetch('/api/calendar/2627/H2');
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const games: CalendarGame[] = await response.json();
      const dateFormatter = new Intl.DateTimeFormat('nl-BE', { day: '2-digit', month: 'short', year: 'numeric' });

      body.replaceChildren();
      for (const game of games) {
        const row = document.createElement('tr');
        row.className = 'border-t border-slate-100';
        const values = [
          dateFormatter.format(new Date(game.DateTime)),
          `${game.DateTime.slice(11, 16)}h`,
          game.TeamHome,
          game.TeamAway,
          game.ScoreHome === null || game.ScoreAway === null ? '-' : `${game.ScoreHome} - ${game.ScoreAway}`,
        ];
        values.forEach((value, index) => {
          const cell = document.createElement('td');
          cell.className = `px-4 py-3${index === 0 ? ' whitespace-nowrap' : ''}${index === 2 ? ' font-medium text-slate-900' : ''}`;
          cell.textContent = value;
          row.append(cell);
        });
        body.append(row);
      }

      h2Loaded = true;
      table.classList.toggle('hidden', games.length === 0);
      status.textContent = games.length === 0 ? 'Geen wedstrijden gevonden.' : '';
      status.classList.toggle('hidden', games.length > 0);
    } catch {
      status.textContent = 'De kalender kon niet worden geladen. Open dit tabblad opnieuw om het nog eens te proberen.';
    } finally {
      h2Loading = false;
    }
  };

  const activateTab = (target: string, updateUrl = false) => {
    const activeButton = Array.from(buttons).find((button) => button.dataset.tabTarget === target);
    if (!activeButton) return;

    buttons.forEach((button) => {
      const isActive = button === activeButton;
      button.classList.toggle('border-orange-600', isActive);
      button.classList.toggle('text-orange-600', isActive);
      button.classList.toggle('border-transparent', !isActive);
      button.classList.toggle('text-slate-600', !isActive);
    });
    panels.forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.tabPanel !== target);
    });
    if (target === 'h2') void loadH2();

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('team', target);
      window.history.replaceState({}, '', url);
    }
  };

  const initialTarget = new URL(window.location.href).searchParams.get('team');
  if (initialTarget) activateTab(initialTarget);

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.tabTarget;
      if (target) activateTab(target, true);
    });
  });
</script>
