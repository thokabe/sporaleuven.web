---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const teams = (await getCollection('teams'))
  .filter((team) => team.id !== 'heren-1' && team.id !== 'dames-1')
  .sort((a, b) => a.data.category.localeCompare(b.data.category));
const games = (await getCollection('games')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const competitionTabs = [
  { id: 'h2', name: 'Heren 1', path: '/2627/vlm/H2' },
  { id: 'd2a', name: 'Dames 1', path: '/2627/vlm/D2A' },
];
const selectedTeamId = competitionTabs.some((tab) => tab.id === Astro.url.searchParams.get('team')) || teams.some((team) => team.id === Astro.url.searchParams.get('team'))
  ? Astro.url.searchParams.get('team')
  : teams[0]?.id;

const rows = await Promise.all(
  games.map(async (game) => {
    const team = await getEntry('teams', game.data.team);
    const teamName = team?.data.name ?? game.data.team;
    const isHome = game.data.homeOrAway === 'thuis';
    return {
      ...game.data,
      thuisploeg: isHome ? teamName : game.data.opponent,
      bezoekers: isHome ? game.data.opponent : teamName,
    };
  })
);

const maandAfkortingen = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
const dagAfkortingen = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
const formatDatum = (date: Date) =>
  `${String(date.getDate()).padStart(2, '0')} ${maandAfkortingen[date.getMonth()]} ${String(date.getFullYear() % 100).padStart(2, '0')}`;
---

<BaseLayout title="Kalender">
  <h1 class="text-3xl font-bold text-slate-900">Wedstrijdkalender</h1>

  <div class="mt-6 flex flex-wrap gap-2 border-b border-slate-200">
    {teams.map((team) => (
      <button
        type="button"
        data-tab-target={team.id}
        class:list={[
          'tab-button cursor-pointer border-b-2 px-4 py-2 text-sm font-medium transition-colors',
          team.id === selectedTeamId ? 'border-orange-600 text-orange-600' : 'border-transparent text-slate-600 hover:text-orange-600',
        ]}
      >
        {team.data.name}
      </button>
    ))}
    {competitionTabs.map((competition) => (
      <button
        type="button"
        data-tab-target={competition.id}
        class:list={[
          'tab-button cursor-pointer border-b-2 px-4 py-2 text-sm font-medium transition-colors',
          selectedTeamId === competition.id ? 'border-orange-600 text-orange-600' : 'border-transparent text-slate-600 hover:text-orange-600',
        ]}
      >
        {competition.name}
      </button>
    ))}
  </div>

  {teams.map((team) => (
    <div data-tab-panel={team.id} class:list={['mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm', { hidden: team.id !== selectedTeamId }]}>
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-100 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-3">Dag</th>
            <th class="px-4 py-3">Datum</th>
            <th class="px-4 py-3">Uur</th>
            <th class="px-4 py-3">Thuisploeg</th>
            <th class="px-4 py-3">Bezoekers</th>
            <th class="px-4 py-3">Locatie</th>
          </tr>
        </thead>
        <tbody>
          {rows
            .filter((row) => row.team === team.id)
            .map((row) => (
              <tr class="border-t border-slate-100">
                <td class="px-4 py-3">{dagAfkortingen[row.date.getDay()]}</td>
                <td class="whitespace-nowrap px-4 py-3">{formatDatum(row.date)}</td>
                <td class="px-4 py-3">{row.time}h</td>
                <td class="px-4 py-3 font-medium text-slate-900">{row.thuisploeg}</td>
                <td class="px-4 py-3">{row.bezoekers}</td>
                <td class="px-4 py-3">{row.location}</td>
              </tr>
            ))}
        </tbody>
      </table>
    </div>
  ))}
  {competitionTabs.map((competition) => (
    <div data-tab-panel={competition.id} data-competition-path={competition.path} class:list={['mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm', { hidden: selectedTeamId !== competition.id }]}>
      <section aria-labelledby={`${competition.id}-ranking-heading`} class="border-b border-slate-200">
        <h2 id={`${competition.id}-ranking-heading`} class="px-4 pt-4 text-lg font-semibold text-slate-900">Rangschikking</h2>
        <p data-ranking-status role="status" class="px-4 py-3 text-sm text-slate-600">Rangschikking laden...</p>
        <table data-ranking-table class="hidden w-full text-left text-sm">
          <thead class="bg-slate-100 text-xs uppercase text-slate-500">
            <tr>
              <th class="px-4 py-3">#</th>
              <th class="px-4 py-3">Ploeg</th>
              <th class="px-4 py-3">Wedstrijden</th>
              <th class="px-4 py-3">W3</th>
              <th class="px-4 py-3">W2</th>
              <th class="px-4 py-3">W1</th>
              <th class="px-4 py-3">Sets voor</th>
              <th class="px-4 py-3">Sets tegen</th>
              <th class="px-4 py-3">Punten</th>
              <th class="px-4 py-3">Forfaits</th>
            </tr>
          </thead>
          <tbody data-ranking-rows></tbody>
        </table>
      </section>
      <div class="border-b border-slate-200 px-4 py-3">
        <label for={`${competition.id}-team`} class="block text-sm font-medium text-slate-900">Ploeg</label>
        <select id={`${competition.id}-team`} data-competition-team disabled class="mt-1 w-full max-w-sm rounded border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-orange-600 focus:outline-none disabled:opacity-50">
          <option value="">Alle ploegen</option>
        </select>
        <p data-teams-status role="status" class="hidden mt-2 text-sm text-slate-600"></p>
      </div>
      <p data-calendar-status role="status" class="px-4 py-3 text-sm text-slate-600">Kalender laden...</p>
      <table data-competition-table class="hidden w-full text-left text-sm">
        <thead class="bg-slate-100 text-xs uppercase text-slate-500">
          <tr>
            <th class="w-px whitespace-nowrap py-3 pl-4 pr-2">Dag</th>
            <th class="px-4 py-3 text-right">Datum</th>
            <th class="px-4 py-3">Uur</th>
            <th class="px-4 py-3">Thuisploeg</th>
            <th class="px-4 py-3">Bezoekers</th>
            <th class="px-4 py-3">Uitslag</th>
          </tr>
        </thead>
        <tbody data-competition-rows></tbody>
      </table>
    </div>
  ))}
</BaseLayout>

<script>
  type CalendarGame = {
    DateTime: string;
    DateTimeWithDayOfWeek: string;
    DateWithDayOfWeek: string;
    TeamHome: string;
    TeamAway: string;
    ScoreHome: number | null;
    ScoreAway: number | null;
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
  const timeFormatter = new Intl.DateTimeFormat('nl-BE', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const competitionLoaders = new Map<string, () => void>();

  document.querySelectorAll<HTMLElement>('[data-competition-path]').forEach((panel) => {
    const calendarPath = panel.dataset.competitionPath!;
    const status = panel.querySelector<HTMLElement>('[data-calendar-status]')!;
    const table = panel.querySelector<HTMLTableElement>('[data-competition-table]')!;
    const body = panel.querySelector<HTMLTableSectionElement>('[data-competition-rows]')!;
    const teamSelect = panel.querySelector<HTMLSelectElement>('[data-competition-team]')!;
    const teamsStatus = panel.querySelector<HTMLElement>('[data-teams-status]')!;
    let games: CalendarGame[] = [];
    let calendarLoaded = false;
    let calendarLoading = false;
    let rankingLoaded = false;
    let rankingLoading = false;
    let teamsLoaded = false;
    let teamsLoading = false;
    const renderCalendar = () => {
      body.replaceChildren();
      const filteredGames = games.filter((game) => !teamSelect.value || game.TeamHome === teamSelect.value || game.TeamAway === teamSelect.value);
      for (const game of filteredGames) {
        const row = document.createElement('tr');
        row.className = 'border-t border-slate-100';
        const [dayOfWeek, ...dateParts] = game.DateWithDayOfWeek.split(' ');
        const values = [
          dayOfWeek,
          dateParts.join(' '),
          timeFormatter.format(new Date(game.DateTime)),
          game.TeamHome,
          game.TeamAway,
          game.ScoreHome === null || game.ScoreAway === null ? '-' : `${game.ScoreHome} - ${game.ScoreAway}`,
        ];
        values.forEach((value, index) => {
          const cell = document.createElement('td');
          cell.className = `py-3${index === 0 ? ' w-px whitespace-nowrap pl-4 pr-2' : ' px-4'}${index === 1 ? ' whitespace-nowrap text-right' : ''}${index === 3 ? ' font-medium text-slate-900' : ''}`;
          cell.textContent = value;
          row.append(cell);
        });
        body.append(row);
      }

      table.classList.toggle('hidden', filteredGames.length === 0);
      status.textContent = filteredGames.length === 0 ? 'Geen wedstrijden gevonden.' : '';
      status.classList.toggle('hidden', filteredGames.length > 0);
    };

    const loadCalendar = async () => {
      if (calendarLoaded || calendarLoading) return;
      calendarLoading = true;
      status.textContent = 'Kalender laden...';
      status.classList.remove('hidden');

      try {
        const response = await fetch(`/api/calendar${calendarPath}`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        games = await response.json();

        calendarLoaded = true;
        renderCalendar();
      } catch {
        status.textContent = 'De kalender kon niet worden geladen. Open dit tabblad opnieuw om het nog eens te proberen.';
      } finally {
        calendarLoading = false;
      }
    };

    const loadTeams = async () => {
      if (teamsLoaded || teamsLoading) return;
      teamsLoading = true;
      teamsStatus.classList.add('hidden');

      try {
        const response = await fetch(`/api/teams${calendarPath}`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const teams: string[] = await response.json();
        teamSelect.append(...teams.map((team) => new Option(team, team)));
        teamSelect.value = teams.find((team) => /spora/i.test(team)) ?? '';
        teamSelect.disabled = teams.length === 0;
        teamsLoaded = true;
        if (calendarLoaded) renderCalendar();
        if (teams.length === 0) {
          teamsStatus.textContent = 'Geen ploegen gevonden.';
          teamsStatus.classList.remove('hidden');
        }
      } catch {
        teamsStatus.textContent = 'Ploegen konden niet worden geladen. Open dit tabblad opnieuw om het nog eens te proberen.';
        teamsStatus.classList.remove('hidden');
      } finally {
        teamsLoading = false;
      }
    };

    teamSelect.addEventListener('change', renderCalendar);
    competitionLoaders.set(panel.dataset.tabPanel!, () => {
      void loadRanking();
      void loadCalendar();
      void loadTeams();
    });
  });

  const activateTab = (target: string, updateUrl = false) => {
    const activeButton = Array.from(buttons).find((button) => button.dataset.tabTarget === target);
    if (!activeButton) return;

    buttons.forEach((button) => {
      const isActive = button === activeButton;
      button.classList.toggle('border-orange-600', isActive);
      button.classList.toggle('text-orange-600', isActive);
      button.classList.toggle('border-transparent', !isActive);
      button.classList.toggle('text-slate-600', !isActive);
    });
    panels.forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.tabPanel !== target);
    });
    competitionLoaders.get(target)?.();

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('team', target);
      window.history.replaceState({}, '', url);
    }
  };

  const initialTarget = new URL(window.location.href).searchParams.get('team');
  if (initialTarget) activateTab(initialTarget);

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.tabTarget;
      if (target) activateTab(target, true);
    });
  });
</script>
