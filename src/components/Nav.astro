---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/teams', label: 'Teams' },
  { href: '/calendar', label: 'Kalender' },
  { href: '/ranking', label: 'Rangschikking' },
  { href: '/history', label: 'De oude doos' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.jpg" alt="Spora Leuven logo" class="h-14 w-auto" />
      <span class="text-lg font-bold text-slate-900">Spora Leuven</span>
    </a>
    <nav>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition-colors hover:text-orange-600',
                currentPath === item.href ? 'text-orange-600' : 'text-slate-700',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
